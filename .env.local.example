# Firebase web config — copy this file to ".env.local" and fill in the values.
# Find them in: Firebase console → Project settings → "Your apps" → SDK setup & configuration → Config.
# These NEXT_PUBLIC_ values are embedded in the client bundle (Firebase web config is not secret;
# access is controlled by Firestore security rules, not by hiding these keys).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL — required for online multiplayer lobbies.
# Create a Realtime Database in the console; the URL looks like
# https://<project>-default-rtdb.firebaseio.com (or a region-specific host).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Cloudinary — required for the admin "image sets" feature (uploading game tile images).
# Create a free Cloudinary account, then Settings → Upload → add an UNSIGNED upload preset.
# (Recommended: restrict the preset to a folder, max size, and image formats.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
